{"m_SGVersion":1,"m_Type":"UnityEditor.ShaderGraph.CustomFunctionNode","m_ObjectId":"abdbae4321ee4a169c1c759b08a37db7","m_Group":{"m_Id":""},"m_Name":"Animated Water - Shore Foam - Caustics","m_DrawState":{"m_Expanded":true,"m_Position":{"y":200,"serializedVersion":"2","width":240,"height":180,"x":"-300"}},"m_Slots":[{"m_Id":"2f533808ca694ec9b9fe2fc61b3b5968"},{"m_Id":"98112d29a2fa43d48074c68eebf832a8"},{"m_Id":"4fd0f4651f574ee7877e5a4728f9040c"},{"m_Id":"6d623f74ddfc44d2a3e47907b527ab10"},{"m_Id":"f50dfd8f98f44f2c8b2c100a1942358c"},{"m_Id":"a09f6fc1177045b395fff95e5da12136"},{"m_Id":"5ccd5de95ce140f381941abbd2926871"},{"m_Id":"337ffdc3a8ac452d98a9e4d0a1140d38"},{"m_Id":"7920cae0c37a49df87b12434703e3e8b"},{"m_Id":"513ba0a12a824eee92a56dd061602d59"},{"m_Id":"f73b057585ab4ea7a3dc38ab61711aec"}],"synonyms":[],"m_Precision":1,"m_PreviewExpanded":true,"m_DismissedVersion":0,"m_PreviewMode":0,"m_CustomColors":{"m_SerializableColors":[]},"m_SourceType":1,"m_FunctionName":"OrganicLake","m_FunctionSource":"","m_FunctionSourceUsePragmas":true,"m_FunctionBody":"float2 a=UV.xy*float2(18,13)+Time*float2(.012,.008);\nfloat2 b=UV.yx*float2(11,16)+Time*float2(-.009,.011);\nfloat3 n1=UnpackNormal(SAMPLE_TEXTURE2D(Waves.tex,Waves.samplerstate,a));\nfloat3 n2=UnpackNormal(SAMPLE_TEXTURE2D(Waves.tex,Waves.samplerstate,b));\nNormal=normalize(float3((n1.xy+n2.xy)*.38,1));\nfloat depth=saturate(Depth.r);\nfloat ripples=sin((UV.x+UV.y)*175-Time*1.4)*.5+.5;\nfloat foam=(1-smoothstep(.008,.055,depth))*smoothstep(.55,.95,ripples)*.55;\nColor=lerp(Shallow.rgb,Deep.rgb,pow(depth,.62))*.70;\nColor=lerp(Color,float3(.94,.98,1),foam);\nfloat cells=sin(UV.x*146+UV.y*81+sin(UV.y*96-Time)*.6+Time)+sin(UV.y*173-UV.x*53+cos(UV.x*114+Time*.7)*.6-Time*.7);\nfloat caustic=pow(1-saturate(abs(cells)*4),7)*(1-depth)*.025;\nEmission=Shallow.rgb*caustic;\nSmoothness=.89;\nAlpha=lerp(.83,.97,saturate(depth*2));"}